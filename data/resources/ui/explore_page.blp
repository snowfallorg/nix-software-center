using Gtk 4.0;
using Adw 1;

template $NscExplorePage: Adw.BreakpointBin {
  width-request: 360;
  height-request: 200;

  child: Gtk.ScrolledWindow {
    child: Adw.Clamp {
      maximum-size: 1500;
      tightening-threshold: 800;

      child: Gtk.Box {
        orientation: vertical;
        margin-start: 10;
        margin-end: 10;
        margin-top: 30;
        margin-bottom: 30;

        Gtk.FlowBox flow_box {
          homogeneous: true;
          selection-mode: none;
          column-spacing: 5;
          row-spacing: 5;
          max-children-per-line: 4;
          focusable: false;
        }
      };
    };
  };
}
