using Gtk 4.0;
using Adw 1;

Adw.ShortcutsDialog shortcuts_dialog {
  Adw.ShortcutsSection {
    title: _("General");

    Adw.ShortcutsItem {
      action-name: "app.shortcuts";
      title: _("Show Shortcuts");
    }

    Adw.ShortcutsItem {
      action-name: "win.search";
      title: _("Search");
    }

    Adw.ShortcutsItem {
      action-name: "app.quit";
      title: _("Quit");
    }
  }
}
