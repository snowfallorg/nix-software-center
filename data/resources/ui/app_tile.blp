using Gtk 4.0;

template $NscAppTile: Gtk.Button {
  styles [
    "card",
  ]

  child: Gtk.Box {
    orientation: horizontal;
    spacing: 15;
    margin-top: 10;
    margin-bottom: 10;
    margin-start: 10;
    margin-end: 10;
    can-focus: false;

    Gtk.Image icon {
      pixel-size: 64;

      styles [
        "icon-dropshadow",
      ]
    }

    Gtk.Box {
      orientation: vertical;
      spacing: 4;
      valign: center;
      hexpand: true;

      Gtk.Label name_label {
        styles [
          "title-4",
        ]

        halign: fill;
        max-width-chars: 12;
        ellipsize: end;
        xalign: 0;
      }

      Gtk.Label summary_label {
        styles [
          "dim-label",
        ]

        halign: fill;
        ellipsize: end;
        lines: 2;
        max-width-chars: 12;
        wrap: true;
        single-line-mode: true;
        xalign: 0;
        yalign: 0;
      }
    }
  };
}
