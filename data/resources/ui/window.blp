using Gtk 4.0;
using Adw 1;

menu primary_menu {
  section {
    item {
      action: "app.preferences";
      label: _("_Preferences");
    }

    item {
      action: "win.show-help-overlay";
      label: _("_Keyboard Shortcuts");
    }

    item {
      action: "app.about";
      label: _("_About Nix Software Center");
    }
  }
}

template $NscWindow: Adw.ApplicationWindow {
  width-request: 360;
  height-request: 294;

  Adw.Breakpoint {
    condition ("max-width: 550sp")

    setters {
      headerbar.title-widget: null;
      switcher_bar.reveal: true;
    }
  }

  content: Adw.NavigationView navigation_view {
    Adw.NavigationPage {
      title: _("Nix Software Center");
      tag: "main";

      child: Adw.ToolbarView {
        [top]
        Adw.HeaderBar headerbar {
          [start]
          ToggleButton search_button {
            icon-name: "system-search-symbolic";
            tooltip-text: _("Search");
          }

          [title]
          Adw.ViewSwitcher header_switcher {
            stack: view_stack;
            policy: wide;
          }

          [end]
          MenuButton appmenu_button {
            icon-name: "open-menu-symbolic";
            menu-model: primary_menu;
            primary: true;
            tooltip-text: _("Main Menu");
          }
        }

        [top]
        Gtk.SearchBar search_bar {
          search-mode-enabled: bind search_button.active bidirectional;

          child: Adw.Clamp {
            maximum-size: 500;

            child: Gtk.SearchEntry search_entry {
              hexpand: true;
              placeholder-text: _("Search apps");
            };
          };
        }

        content: Adw.ViewStack view_stack {
          Adw.ViewStackPage {
            name: "explore";
            title: _("Explore");
            icon-name: "explore-symbolic";

            child: $NscExplorePage {};
          }

          Adw.ViewStackPage {
            name: "installed";
            title: _("Installed");
            icon-name: "check-plain-symbolic";

            child: $NscInstalledPage {};
          }

          Adw.ViewStackPage {
            name: "updates";
            title: _("Updates");
            icon-name: "software-update-available-symbolic";

            child: $NscUpdatesPage {};
          }

          Adw.ViewStackPage {
            name: "search";
            visible: false;

            child: $NscSearchPage search_page {};
          }
        };

        [bottom]
        Adw.ViewSwitcherBar switcher_bar {
          stack: view_stack;
        }
      };
    }
  };
}
